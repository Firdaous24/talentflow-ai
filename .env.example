# Safe placeholders for local Docker Compose only. Replace before shared use.
# Never use these credentials for production or commit a real .env file.
POSTGRES_DB=talentflow_local
POSTGRES_USER=talentflow_local
POSTGRES_PASSWORD=change-me-local-development-only

# Optional model extraction. Leave empty for fully local processing.
# Supply an OpenAI-compatible API base URL (including its API version path),
# an actual model supported by that server, and credentials only in root .env.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
