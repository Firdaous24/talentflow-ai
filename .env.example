# Safe placeholders for local Docker Compose only. Copy to .env and replace them.
# Never use these values for a shared or online instance, and never commit .env.

# PostgreSQL (required since phase 6). The password is only read when the
# postgres_data volume is first initialized; changing it later does not
# change the existing database password.
POSTGRES_DB=talentflow_local
POSTGRES_USER=talentflow_local
POSTGRES_PASSWORD=change-me-local-development-only

# Account platform (/api/v2). Required: a generated secret of at least 32
# characters, used for CSRF tokens and audit pseudonyms. The backend refuses
# values starting with "change-me". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TALENTFLOW_SECRET_KEY=change-me-generate-a-random-secret-of-48-characters

# Session cookies are Secure (HTTPS only) by default. Local Compose serves
# plain HTTP on 127.0.0.1, so local development turns this off. Never set it
# to false on an online instance.
SESSION_COOKIE_SECURE=false

# Base URL used in e-mail links (verification, password reset).
APP_BASE_URL=http://localhost:5173

# Extra host names accepted by /api/v1 and /api/v2, comma-separated. Empty means
# loopback only. An online demo must list its own host name here.
TALENTFLOW_ALLOWED_HOSTS=

# Sender shown in e-mails. Compose delivers every message to the local Mailpit
# inbox (http://localhost:8025); no external e-mail provider is used in v1.
MAIL_FROM=TalentFlow AI <no-reply@talentflow.example>

# Optional model extraction. Leave empty for fully local processing.
# Supply an OpenAI-compatible API base URL (including its API version path),
# an actual model supported by that server, and credentials only in root .env.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Reserved for phase 7 (CV text encryption at rest): a base64-encoded 32-byte
# key, supplied only through the environment. Not read in phase 6.
# TALENTFLOW_DATA_KEY=
